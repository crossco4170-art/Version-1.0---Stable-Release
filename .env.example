APP_NAME=BlackcrestRecruitOS
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me
WIX_API_KEY=YOUR_API_KEY
WIX_SITE_ID=YOUR_SITE_ID
WIX_ACCOUNT_ID=YOUR_ACCOUNT_ID
WIX_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
DATABASE_PATH=./blackcrest.db
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
GMAIL_USERNAME=replace-me
GMAIL_PASSWORD=replace-me
RECRUITER_NOTIFICATION_EMAILS=recruiter1@example.com,recruiter2@example.com
SCORE_NOTIFICATION_THRESHOLD=85
GMAIL_RETRY_ATTEMPTS=3
GMAIL_RETRY_DELAY_SECONDS=2
LOG_LEVEL=INFO
LOG_DIR=logs
